{
  "name": "Python-Flask-Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/uv": {}
  },
  // Container environment variables
  "containerEnv": {
    "MyKey": "MyValue"
  },
  // Providing the Port to be forwarded to the host machine
  "forwardPorts": [5000],
  // Defining the Port Attributes
  "portsAttributes": {
    "5000": {
      "label": "Flask Application",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopContainer",
  // Vs code customization in the devcontainer environment
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.quickSuggestions": {
            "strings": true
          },
          "editor.suggest.insertMode": "replace"
        }
      }
    }
  },
  // Command to run after the container is created
  "postCreateCommand": "uv sync"
}
